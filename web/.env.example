# Google OAuth + Drive appData (web only)
#
# 1. Create a Google Cloud project
# 2. Enable Google Drive API
# 3. Configure OAuth consent screen (External or Internal)
# 4. Create OAuth client ID → Web application
#    Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 5. Paste values below into .env.local (never commit secrets)

AUTH_SECRET=generate-with-npx-auth-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Optional: force consent so refresh tokens are issued on first login
# AUTH_GOOGLE_PROMPT=consent
