{
  "expo": {
    "name": "Galaxy Health",
    "slug": "galaxy-health",
    "version": "0.1.0",
    "scheme": "galaxyhealth",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.galaxyhealth.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070F"
      },
      "package": "com.galaxyhealth.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
